# RPM Spec File Template
# Generated by Shipyard

# Disable the default RPM build process steps
%define __spec_prep_post true
%define __spec_prep_pre true
%define __spec_build_post true
%define __spec_build_pre true
%define __spec_install_post true
%define __spec_install_pre true
%define __spec_clean_post true
%define __spec_clean_pre true

# Allow building noarch packages that contain binaries
%define _binaries_in_noarch_packages_terminate_build 0

# Use SHA256 file digest method
%define _binary_filedigest_algorithm 10
%define _build_binary_file_digest_algo 10

# Use gzip payload compression
%define _binary_payload w10.gzdio

Name: {{ package_name }}
Version: {{ version }}
Release: {{ release }}
BuildArch: {{ build_arch }}
Summary: {{ summary }}

{{ if prefix }}
Prefix: {{ prefix }}
{{ end }}

Group: Development/Tools
License: {{ license }}

{{ if vendor }}
Vendor: {{ vendor }}
{{ end }}

{{ if url }}
URL: {{ url }}
{{ else }}
URL: http://example.com/
{{ end }}

Packager: {{ author }}

{{ if depends_on }}
{{~ for dep in depends_on ~}}
Requires: {{ dep }}
{{~ end ~}}
{{ end }}

{{ if provides }}
{{~ for prov in provides ~}}
Provides: {{ prov }}
{{~ end ~}}
{{ end }}

%description
{{ description }}

%prep
# noop

%build
# noop

%install
%{__mkdir_p} %{buildroot}/usr/local/bin # Symlink to the binary will go here
%{__mkdir_p} %{buildroot}/usr/share/{{ package_name }} # Published files will go here
{{ if systemd_service_name }}
%{__mkdir_p} %{buildroot}/etc/systemd/system # Systemd service file will go here
{{ end }}

# Install all published files to /usr/share/{{ package_name }}/
cp -r %{_topdir}/SOURCE/* %{buildroot}/usr/share/{{ package_name }}/

# Create symlink in /usr/local/bin/{{ package_name }} pointing to the actual binary
ln -s ../../share/{{ package_name }}/{{ executable_name }} %{buildroot}/usr/local/bin/{{ executable_name }}

{{ if systemd_service_name }}
# Install the systemd service file
%{__install} -m0644 %{_topdir}/{{ systemd_service_name }} %{buildroot}/etc/systemd/system/{{ systemd_service_name }}
{{ end }}

%clean
# noop

{{ if pre_install_script }}
%pre
{{ pre_install_script }}
{{ end }}

{{ if post_install_script }}
%post
{{ post_install_script }}
{{ end }}

{{ if pre_uninstall_script }}
%preun
{{ pre_uninstall_script }}
{{ end }}

{{ if post_uninstall_script }}
%postun
{{ post_uninstall_script }}
{{ end }}

%files
/usr/local/bin/{{ executable_name }}
/usr/share/{{ package_name }}/
{{ if systemd_service_name }}
/etc/systemd/system/{{ systemd_service_name }}
{{ end }}

{{ if changelog_date }}

%changelog
* {{ changelog_date }} {{ author }}
- Auto-generated by Shipyard

{{ end }}