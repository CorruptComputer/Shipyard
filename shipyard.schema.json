{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shipyard Project Configuration",
  "description": "Schema for Shipyard project configuration files",
  "type": "object",
  "required": [
    "executable",
    "version",
    "author",
    "license",
    "repositoryUrl",
    "dotnet",
    "formats"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The schema version"
    },
    "executable": {
      "type": "string",
      "description": "The name of the executable to be built"
    },
    "version": {
      "type": "string",
      "description": "The version of the project",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "author": {
      "type": "string",
      "description": "The developer or author of the project"
    },
    "license": {
      "type": "string",
      "description": "The license of the project (SPDX format recommended)",
      "examples": [
        "MIT",
        "Apache-2.0",
        "GPL-3.0"
      ]
    },
    "repositoryUrl": {
      "type": "string",
      "description": "The repository URL for the project source",
      "format": "uri"
    },
    "dotnet": {
      "$ref": "#/definitions/dotnetConfig"
    },
    "formats": {
      "type": "array",
      "description": "Format-specific configurations",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/debConfig"
          },
          {
            "$ref": "#/definitions/rpmConfig"
          }
        ]
      }
    }
  },
  "definitions": {
    "debConfig": {
      "type": "object",
      "title": "DEB Configuration",
      "description": "Configuration specific to DEB (Debian/Ubuntu) package format",
      "required": [
        "format",
        "packageName",
        "section",
        "priority",
        "maintainer"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "const": "deb",
          "description": "Format type identifier"
        },
        "packageName": {
          "type": "string",
          "description": "The name of the package"
        },
        "section": {
          "type": "string",
          "description": "The section of the package (e.g., 'utils', 'net', 'admin')"
        },
        "priority": {
          "type": "string",
          "description": "The priority of the package (e.g., 'optional', 'standard', 'required')"
        },
        "maintainer": {
          "type": "string",
          "description": "The maintainer of the package, must be in the format 'Name <email>'"
        },
        "depends": {
          "type": "array",
          "description": "Optionally, the dependencies which this package requires",
          "items": {
            "type": "string"
          },
          "examples": [
            "dotnet-runtime-10.0",
            "foo"
          ]
        },
        "installSystemdService": {
          "type": "boolean",
          "description": "Optionally, a flag indicating whether to install a systemd service unit"
        },
        "systemdServiceName": {
          "type": "string",
          "description": "Optionally, the name of the systemd service"
        }
      }
    },
    "dotnetConfig": {
      "type": "object",
      "title": "DotNet Configuration",
      "description": "Configurations for .NET publishing in Shipyard",
      "required": [
        "projectFile",
        "configuration",
        "framework",
        "runtimes"
      ],
      "additionalProperties": false,
      "properties": {
        "projectFile": {
          "type": "string",
          "description": "The path to the .NET project file (.csproj, .fsproj, or .vbproj). If relative, interpreted relative to the configuration file location."
        },
        "configuration": {
          "type": "string",
          "description": "The build configuration (e.g., 'Release' or 'Debug')",
          "enum": [
            "Debug",
            "Release"
          ]
        },
        "framework": {
          "type": "string",
          "description": "The target framework (e.g., 'net8.0', 'net9.0'). See: https://learn.microsoft.com/en-us/dotnet/standard/frameworks#supported-target-frameworks",
          "examples": [
            "net9.0",
            "net10.0"
          ]
        },
        "publish": {
          "type": "array",
          "description": "The publish options",
          "items": {
            "type": "string"
          }
        },
        "runtimes": {
          "type": "array",
          "description": "The runtime identifiers (RIDs) for target platforms (e.g., 'linux-x64', 'linux-arm64'). See: https://learn.microsoft.com/en-us/dotnet/core/rid-catalog#linux-rids",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "linux",
              "linux-x64",
              "linux-musl-x64",
              "linux-musl-arm64",
              "linux-arm",
              "linux-arm64",
              "linux-bionic-arm64",
              "linux-loongarch64"
            ]
          }
        }
      }
    },
    "rpmConfig": {
      "type": "object",
      "title": "RPM Configuration",
      "description": "Configuration specific to RPM (RedHat/CentOS/Fedora) package format",
      "required": [
        "format",
        "packageName",
        "release"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "const": "rpm",
          "description": "Format type identifier"
        },
        "packageName": {
          "type": "string",
          "description": "The name of the package"
        },
        "release": {
          "type": "integer",
          "description": "The release number (incremented for rebuilds of the same version)",
          "minimum": 1
        },
        "provides": {
          "type": "array",
          "description": "Optionally, the dependencies which this package provides",
          "items": {
            "type": "string"
          },
          "examples": [
            "foo"
          ]
        },
        "dependsOn": {
          "type": "array",
          "description": "Optionally, the dependencies which this package requires",
          "items": {
            "type": "string"
          },
          "examples": [
            "dotnet-runtime-10.0",
            "foo"
          ]
        },
        "installSystemdService": {
          "type": "boolean",
          "description": "Optionally, a flag indicating whether to install a systemd service unit"
        },
        "systemdServiceName": {
          "type": "string",
          "description": "Optionally, the name of the systemd service"
        },
        "preInstallScript": {
          "type": "string",
          "description": "Optionally, a script to run before installation"
        },
        "postInstallScript": {
          "type": "string",
          "description": "Optionally, a script to run after installation"
        },
        "preUninstallScript": {
          "type": "string",
          "description": "Optionally, a script to run before uninstallation"
        },
        "postUninstallScript": {
          "type": "string",
          "description": "Optionally, a script to run after uninstallation"
        }
      }
    }
  }
}
